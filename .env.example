# StackPlus HRIS — contoh konfigurasi
# Ganti semua nilai contoh sebelum menjalankan atau men-deploy aplikasi.
# File ini adalah template; jangan isi secret produksi di sini.
#
# Penggunaan lokal:
# 1. Salin bagian API dan DATABASE ke apps/api/.env.
# 2. Salin bagian FRONTEND ke apps/web/.env.local.
# 3. Untuk perintah Prisma dari packages/database (db:generate/db:push/db:studio),
#    salin DATABASE_URL dan DIRECT_URL ke packages/database/.env juga.
# 4. Saat deploy, masukkan variabel yang sama pada pengaturan environment platform.

# ---------------------------------------------------------------------------
# API — NestJS (apps/api)
# ---------------------------------------------------------------------------

# development untuk lokal; set production pada environment API produksi.
# NODE_ENV juga menentukan atribut Secure pada cookie refresh token.
NODE_ENV=development

# Port HTTP API. Default aplikasi adalah 3001.
PORT=3001

# URL PostgreSQL yang dipakai aplikasi. Untuk Neon, gunakan endpoint pooled
# (host biasanya mengandung "-pooler"); untuk PostgreSQL biasa gunakan URL DB.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# URL PostgreSQL langsung/non-pooled untuk operasi Prisma pada schema bersama.
# Bisa sama dengan DATABASE_URL jika provider tidak menyediakan endpoint pooled.
DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?sslmode=require

# Buat dua nilai acak yang berbeda. Contoh generator (jalankan dua kali):
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Jangan gunakan fallback secret bawaan kode pada production.
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET

# Daftar origin frontend yang diizinkan, dipisahkan koma tanpa spasi wajib.
# Sesuaikan domain Vercel/production dengan alamat frontend Anda.
# Jika tidak disetel, API memakai daftar default yang sudah ada di source code.
CORS_ORIGINS=http://localhost:3000,https://web-human-resource-information-syst.vercel.app,https://hris.stackplustudio.com

# ---------------------------------------------------------------------------
# FRONTEND — Next.js (apps/web)
# ---------------------------------------------------------------------------

# URL dasar backend API; jangan tambahkan slash di akhir.
# Nilai NEXT_PUBLIC_* akan tersedia di bundle browser, jadi jangan taruh secret.
NEXT_PUBLIC_API_URL=http://localhost:3001
