// packages/database/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ENUMS untuk standarisasi status dan role
enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  HR_STAFF
  MANAGER
  EMPLOYEE
}

enum EmploymentStatus {
  ACTIVE
  PROBATION
  ON_LEAVE
  RESIGNED
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayrollStatus {
  DRAFT
  PAID
}

// ==========================================
// CORE ENTITIES
// ==========================================

model Tenant {
  id        String   @id @default(uuid())
  name      String
  subdomain String   @unique
  plan      String   @default("STARTER")
  createdAt DateTime @default(now()) @map("created_at")

  // Relasi
  users           User[]
  employees       Employee[]
  departments     Department[]
  attendances     Attendance[]
  leaveRequests   LeaveRequest[]
  leaveBalances   LeaveBalance[]
  payrolls        Payroll[]
  payrollComps    PayrollComponent[]
  auditLogs       AuditLog[]
  PerformanceGoal PerformanceGoal[]
  TaxBpjsConfig   TaxBpjsConfig?
  Candidate       Candidate[]

  @@map("tenants")
}

model User {
  id       String  @id @default(uuid())
  tenantId String? @map("tenant_id") // Nullable untuk Super Admin StackPlus
  email    String  @unique
  password String
  role     Role    @default(EMPLOYEE)
  status   Boolean @default(true)

  tenant   Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee?

  @@map("users")
}

model Employee {
  id               String           @id @default(uuid())
  tenantId         String           @map("tenant_id")
  userId           String           @unique @map("user_id")
  fullName         String           @map("full_name")
  departmentId     String?          @map("department_id")
  position         String
  joinDate         DateTime         @map("join_date")
  employmentStatus EmploymentStatus @default(ACTIVE) @map("employment_status")
  managerId        String?          @map("manager_id")

  // Relasi
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  manager      Employee?   @relation("EmployeeToManager", fields: [managerId], references: [id])
  subordinates Employee[]  @relation("EmployeeToManager")

  attendances     Attendance[]
  leaveRequests   LeaveRequest[]
  leaveBalances   LeaveBalance[]
  payrolls        Payroll[]
  PerformanceGoal PerformanceGoal[]

  @@map("employees")
}

model Department {
  id                 String  @id @default(uuid())
  tenantId           String  @map("tenant_id")
  name               String
  parentDepartmentId String? @map("parent_department_id")

  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parentDepartment Department?  @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id])
  childDepartments Department[] @relation("DepartmentHierarchy")
  employees        Employee[]

  @@map("departments")
}

// ==========================================
// HRIS MODULES
// ==========================================

model Attendance {
  id         String           @id @default(uuid())
  tenantId   String           @map("tenant_id")
  employeeId String           @map("employee_id")
  date       DateTime         @db.Date
  checkIn    DateTime?        @map("check_in")
  checkOut   DateTime?        @map("check_out")
  status     AttendanceStatus
  location   String?

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("attendances")
}

model LeaveRequest {
  id         String      @id @default(uuid())
  tenantId   String      @map("tenant_id")
  employeeId String      @map("employee_id")
  leaveType  String      @map("leave_type")
  startDate  DateTime    @map("start_date") @db.Date
  endDate    DateTime    @map("end_date") @db.Date
  status     LeaveStatus @default(PENDING)
  approvedBy String?     @map("approved_by")
  reason     String?

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("leave_requests")
}

model LeaveBalance {
  id         String @id @default(uuid())
  tenantId   String @map("tenant_id")
  employeeId String @map("employee_id")
  leaveType  String @map("leave_type")
  balance    Int
  year       Int

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("leave_balances")
}

model PayrollComponent {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  name     String
  type     String // "ALLOWANCE" or "DEDUCTION"
  amount   Float

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("payroll_components")
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  actorId   String   @map("actor_id")
  action    String
  entity    String
  timestamp DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

model Payroll {
  id          String        @id @default(uuid())
  tenantId    String
  employeeId  String
  period      String // Contoh: "Agustus 2026"
  basicSalary Float         @default(0)
  allowance   Float         @default(0)
  deduction   Float         @default(0)
  netSalary   Float         @default(0)
  status      PayrollStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, period]) // Cegah 1 karyawan digaji 2x di bulan yang sama
}

// --- TAMBAHAN FASE 3: KPI & PAJAK / BPJS ---

model PerformanceGoal {
  id         String   @id @default(uuid())
  tenantId   String
  employeeId String
  period     String // Contoh: "Q3 2026"
  objective  String
  score      Int      @default(0)
  status     String   @default("ON_PROGRESS") // ON_PROGRESS, GOOD, EXCELLENT, POOR
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model TaxBpjsConfig {
  id                  String   @id @default(uuid())
  tenantId            String   @unique
  bpjsKesehatan       Float    @default(1.0) // Potongan Karyawan 1%
  bpjsKetenagakerjaan Float    @default(2.0) // Potongan Karyawan 2% (JHT)
  ptkpDasar           Float    @default(54000000) // PTKP TK/0 (Rp 54 Juta)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Candidate {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  role      String
  stage     String   @default("APPLIED") // APPLIED, INTERVIEW, OFFERED, HIRED, REJECTED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}
